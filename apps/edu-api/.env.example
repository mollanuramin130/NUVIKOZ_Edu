APP_NAME="NUVIKOZ Edu API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_local
DB_USERNAME=edu_local
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=edu_session
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Exact same-site Edu frontend origins; empty denies browser sessions.
EDU_BROWSER_ORIGINS=
EDU_BROWSER_SECURE=true
