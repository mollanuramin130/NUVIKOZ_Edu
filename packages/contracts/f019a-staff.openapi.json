{
  "openapi": "3.0.3",
  "info": {
    "title": "F019-A School Admin Staff Profiles",
    "version": "1.0.0",
    "description": "School browser session with current MFA. Registration additionally requires enabled current Live entitlement and Origin/CSRF."
  },
  "security": [
    {
      "BrowserSession": []
    }
  ],
  "paths": {
    "/api/v1/browser/staff": {
      "get": {
        "summary": "List staff profiles",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "items",
                        "next_cursor"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 25,
                          "items": {
                            "$ref": "#/components/schemas/Profile"
                          }
                        },
                        "next_cursor": {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$",
                          "nullable": true
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "403": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "404": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "419": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "422": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "429": {
            "$ref": "#/components/responses/RequestDenied"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            }
          }
        ]
      },
      "post": {
        "summary": "Register an existing eligible school membership",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Registration"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "403": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "404": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "419": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "422": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "429": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Registration"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "415": {
            "$ref": "#/components/responses/RequestDenied"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,160}$"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "membership_id"
                ],
                "properties": {
                  "membership_id": {
                    "type": "string",
                    "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/browser/staff/eligible-memberships": {
      "get": {
        "summary": "List eligible memberships",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "items",
                        "next_cursor"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 25,
                          "items": {
                            "$ref": "#/components/schemas/Candidate"
                          }
                        },
                        "next_cursor": {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$",
                          "nullable": true
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "403": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "404": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "419": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "422": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "429": {
            "$ref": "#/components/responses/RequestDenied"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            }
          }
        ]
      }
    },
    "/api/v1/browser/staff/{id}": {
      "get": {
        "summary": "Read staff profile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "403": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "404": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "419": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "422": {
            "$ref": "#/components/responses/RequestDenied"
          },
          "429": {
            "$ref": "#/components/responses/RequestDenied"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "membership_id",
          "display_name",
          "role"
        ],
        "properties": {
          "membership_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "principal",
              "teacher"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "membership_id",
          "display_name",
          "role",
          "eligible_for_registration",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
          },
          "membership_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "eligible_for_registration": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "replayed"
        ],
        "properties": {
          "resource": {
            "$ref": "#/components/schemas/Profile"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edu_browser_session"
      }
    },
    "responses": {
      "RequestDenied": {
        "description": "Request denied",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error",
                "meta"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "fields"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "meta": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
