{
  "openapi": "3.1.0",
  "info": {
    "title": "NUVIKOZ Edu SEC-02 synthetic platform and SEC-03 replacement implemented subset",
    "version": "0.1.0",
    "description": "Additive implemented subset. Production platform issuer/bootstrap remains disabled: testing environment AND explicit server-side synthetic configuration required. The disposable CLI-server harness is not a production enablement path. Existing HTTPS/Origin/CSRF/host-only Secure HttpOnly SameSite=Lax database cookies remain mandatory. No bearer substitution, school impersonation or independently unverified lost-factor reset. Read docs/api/M1_AUTH_INCREMENT_2_CONTRACT.md for current scope and recovery gates."
  },
  "paths": {
    "/api/v1/browser/platform/login": {
      "post": {
        "description": "Synthetic eligible global identity/password only; rotates session/CSRF and starts five-minute pending MFA. Grants no authority.",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact configured first-party HTTPS origin; never wildcard."
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Session-bound token from existing /api/v1/browser/csrf handshake."
          }
        ],
        "responses": {
          "200": {
            "description": "Success envelope; sensitive data is authorized and no-store.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "private and no-store directives; ordering is immaterial."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FirstFactor"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "request_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "request_id"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication/session expired."
          },
          "403": {
            "description": "Transport, Origin, current identity/context or disabled platform issuer denied."
          },
          "404": {
            "description": "Resource unavailable."
          },
          "409": {
            "description": "Unexpired replacement already exists; never silently overwrite it."
          },
          "419": {
            "description": "Missing/stale CSRF; bootstrap again, never automatically replay mutation."
          },
          "422": {
            "description": "Invalid/expired/replayed proof or validation failure; no partial mutation."
          },
          "429": {
            "description": "Rate limited."
          },
          "500": {
            "description": "Transaction/encryption/audit failure; fail closed."
          }
        },
        "x-testing-only": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatformLogin"
              }
            }
          }
        }
      }
    },
