  "components": {
    "securitySchemes": {
      "browserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edu_browser_session"
      }
    },
    "schemas": {
      "PlatformLogin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "format": "ulid"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Current password, at most72 bytes. Never logged or persisted in plaintext."
          }
        }
      },
      "Password": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Current password, at most72 bytes. Never logged or persisted in plaintext."
          }
        }
      },
      "Factor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Current password, at most72 bytes. Never logged or persisted in plaintext."
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "writeOnly": true
          }
        }
      },
      "ReplacementStart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "method",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Current password, at most72 bytes. Never logged or persisted in plaintext."
          },
          "method": {
            "type": "string",
            "enum": [
              "totp",
              "recovery"
            ]
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "writeOnly": true
          }
        }
      },
      "ReplacementConfirm": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "replacement_id",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Current password, at most72 bytes. Never logged or persisted in plaintext."
          },
          "replacement_id": {
            "type": "string",
            "format": "ulid"
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "writeOnly": true
          }
        }
      },
      "FirstFactor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mfa_required",
          "csrf_token"
        ],
        "properties": {
          "mfa_required": {
            "const": true
          },
          "csrf_token": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "enrolled",
          "verified"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "ulid"
          },
          "enrolled": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret",
          "expires_in"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "readOnly": true,
            "description": "Sensitive ephemeral authenticator seed; no browser storage/logs."
          },
          "expires_in": {
            "const": 600
          }
        }
      },
      "Verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verified",
          "recovery_codes",
          "csrf_token"
        ],
        "properties": {
          "verified": {
            "const": true
          },
          "recovery_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Eight codes at enrollment confirmation; empty for later challenges. Display once."
          },
          "csrf_token": {
            "type": "string"
          }
        }
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "context",
          "capabilities"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "ulid"
          },
          "context": {
            "const": "platform"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "const": "platform.health"
            }
          }
        }
      },
      "Logout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revoked",
          "csrf_token"
        ],
        "properties": {
          "revoked": {
            "const": true
          },
          "csrf_token": {
            "type": "string"
          }
        }
      },
      "PendingReplacement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "replacement_id",
          "secret",
          "expires_in"
        ],
        "properties": {
          "replacement_id": {
            "type": "string",
            "format": "ulid"
          },
          "secret": {
            "type": "string",
            "readOnly": true,
            "description": "Sensitive authorized no-store setup response only."
          },
          "expires_in": {
            "const": 300
          }
        }
      },
      "ReplacementComplete": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recovery_codes",
          "reauthentication_required",
          "csrf_token"
        ],
        "properties": {
          "recovery_codes": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "description": "New once-only codes, returned only after atomic commit."
          },
          "reauthentication_required": {
            "const": true
          },
          "csrf_token": {
            "type": "string"
          }
        }
      }
    }
  }
}
