    "/api/v1/browser/security/sessions/{id}/revoke": {
      "post": {
        "description": "Owned opaque session id or others. Revoke with resurrection tombstone; password and privileged MFA required.",
        "security": [
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^([a-f0-9]{64}|others)$"
            }
          }
        ],
        "responses": {
