{
  "openapi": "3.1.0",
  "info": {
    "title": "NUVIKOZ Edu implemented MFA and session/device checkpoint",
    "version": "0.1.0",
    "description": "AUTH-06/07 implemented subset only. No public platform issuer/native privileged-device MFA/reset, delegation or full mobile integration. Read ADR-022 and canonical handoff."
  },
  "paths": {
    "/api/v1/browser/security/mfa/status": {
      "get": {
        "description": "Current School Admin enrollment/assurance status; limited pending-MFA bootstrap.",
        "security": [
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard success envelope; sensitive enrollment/recovery output is no-store and displayed once."
          },
          "401": {
            "description": "Authentication/session expired."
          },
          "403": {
            "description": "Identity, school, role, transport, origin or MFA denied."
          },
          "404": {
            "description": "Owned resource not found."
          },
          "419": {
            "description": "CSRF mismatch on browser mutation."
          },
          "422": {
            "description": "Invalid password/code/input; no partial security mutation."
          },
          "429": {
            "description": "Rate limited."
          },
          "500": {
            "description": "Storage/encryption failure; fail closed."
          }
        }
      }
    },
