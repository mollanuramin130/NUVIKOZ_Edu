        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "schoolSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edu_browser_session"
      }
    },
    "schemas": {
      "SessionCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "starts_on": {
            "type": "string",
            "format": "date"
          },
          "ends_on": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name",
          "starts_on",
          "ends_on"
        ]
      },
      "ClassCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "grade_label": {
            "type": "string",
            "maxLength": 32
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "name",
          "sort_order"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 80
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "maxItems": 100
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "request_id"
            ]
          }
        },
        "required": [
          "error",
          "meta"
        ]
      },
      "AcademicSession": {
        "type": "object",
        "required": [
          "id",
          "name",
          "starts_on",
          "ends_on",
          "state",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "starts_on": {
            "type": "string",
            "format": "date"
          },
          "ends_on": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "type": "string",
            "enum": [
              "future"
            ]
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "SchoolClass": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sort_order",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "grade_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "sort_order": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          }
        }
      }
    }
  }
}
